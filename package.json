{
  "name": "semantle-solver",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Autonomous Hebrew Semantle (סמנטעל) solver — Playwright (headed) + a local model via Ollama.",
  "scripts": {
    "start": "tsx src/solver.ts",
    "play": "tsx src/solver.ts",
    "play:quiet": "cross-env HEADLESS=true tsx src/solver.ts",
    "build:vectors": "tsx scripts/build-vectors.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "playwright": "1.65.0"
  },
  "devDependencies": {
    "@tsconfig/node26": "26.0.1",
    "@types/node": "26.6.6",
    "@typescript/native": "npm:typescript@7.0.2",
    "cross-env": "10.1.0",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "engines": {
    "node": ">=26"
  }
}
